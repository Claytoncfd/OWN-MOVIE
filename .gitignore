# Deps e build
node_modules/
dist/
build/
.next/
coverage/
*.tsbuildinfo

# Segredos e ambiente local
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Cache e temporários
workflows/.object_info_cache.json
*.tmp

# Ferramentas externas e modelos (GBs) — regeneráveis via clone + scripts/
