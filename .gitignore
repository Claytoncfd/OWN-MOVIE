opensource/

# Saídas geradas (vídeos/áudios) — manter só os .gitkeep
output/videos/*
output/audio/*
output/images/*
output/renders/*
!output/videos/.gitkeep
!output/audio/.gitkeep
!output/images/.gitkeep
!output/renders/.gitkeep
